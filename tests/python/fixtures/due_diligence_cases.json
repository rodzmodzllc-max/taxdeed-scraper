{
  "_comment": "Shared vectors for harvesters/sources/due_diligence.checklist() and app.js diligenceChecklistFromFacts(). Only the items listed in 'expect' are asserted per case. Change both implementations together.",
  "cases": [
    {"name": "available_fully_evidenced",
     "facts": {"ledger": "laft", "parcel": true, "county": true, "read_ever": true, "read_recently": true, "legal": "sourced",
               "source_publication": "approved", "source_health": "CURRENT", "acq_path": "verified", "acq_url": true,
               "amount": "current", "amount_date": "current", "coords": "authoritative", "acreage": "sourced", "land_use": "sourced",
               "imagery": "stored", "values": "sourced", "source_record": true, "provenance": true},
     "expect": {"parcel": "VERIFIED", "acq_path": "VERIFIED", "acq_url": "VERIFIED", "acq_amount": "VERIFIED", "coords": "VERIFIED",
                "sale_date": "NOT_APPLICABLE", "cert_number": "NOT_APPLICABLE", "source_health": "VERIFIED", "last_read": "VERIFIED"}},
    {"name": "populated_is_not_verified",
     "facts": {"ledger": "laft", "parcel": true, "county": true, "read_ever": true, "legal": "unsourced", "acreage": "unsourced",
               "land_use": "unsourced", "values": "unsourced", "coords": "other", "source_publication": "approved", "acq_path": "not_verified"},
     "expect": {"legal": "NOT_VERIFIED", "acreage": "NOT_VERIFIED", "land_use": "NOT_VERIFIED", "values": "NOT_VERIFIED",
                "coords": "NOT_VERIFIED", "acq_path": "NOT_VERIFIED", "acq_url": "NOT_VERIFIED", "last_read": "NOT_VERIFIED"}},
    {"name": "nothing_published",
     "facts": {"ledger": "laft", "parcel": false, "legal": "none", "acreage": "none", "coords": "none", "imagery": "checked_none", "amount": "none"},
     "expect": {"parcel": "NOT_PUBLISHED", "legal": "NOT_PUBLISHED", "acreage": "NOT_PUBLISHED", "coords": "NOT_PUBLISHED",
                "imagery": "NOT_PUBLISHED", "acq_amount": "NOT_PUBLISHED", "acq_amount_date": "NOT_PUBLISHED"}},
    {"name": "path_verified_without_document",
     "facts": {"ledger": "laft", "acq_path": "verified", "acq_url": false, "amount": "not_current", "amount_date": "expired"},
     "expect": {"acq_url": "NOT_PUBLISHED", "acq_amount": "NOT_VERIFIED", "acq_amount_date": "NOT_VERIFIED"}},
    {"name": "source_unavailable",
     "facts": {"ledger": "laft", "source_health": "SOURCE_UNAVAILABLE", "source_publication": "approved", "acq_path": "unavailable", "read_ever": true},
     "expect": {"acq_source": "SOURCE_UNAVAILABLE", "acq_path": "SOURCE_UNAVAILABLE", "last_read": "SOURCE_UNAVAILABLE", "source_health": "SOURCE_UNAVAILABLE"}},
    {"name": "source_under_review",
     "facts": {"ledger": "laft", "source_publication": "review", "source_health": "NEEDS_REVIEW"},
     "expect": {"acq_source": "NOT_VERIFIED", "source_health": "NOT_VERIFIED"}},
    {"name": "auction_upcoming",
     "facts": {"ledger": "auction", "sale_date": true, "read_ever": true, "bid": true, "auction_link": true, "sale_outcome": "future"},
     "expect": {"sale_date": "VERIFIED", "bid": "VERIFIED", "auction_source": "VERIFIED", "result": "NOT_APPLICABLE", "acq_path": "NOT_APPLICABLE", "cert_face": "NOT_APPLICABLE"}},
    {"name": "auction_past_no_result",
     "facts": {"ledger": "auction", "sale_date": true, "read_ever": true, "bid": false, "auction_link": false, "sale_outcome": "not_published"},
     "expect": {"bid": "NOT_PUBLISHED", "auction_source": "NOT_VERIFIED", "result": "NOT_PUBLISHED"}},
    {"name": "auction_past_unmapped_wording",
     "facts": {"ledger": "auction", "sale_date": true, "sale_outcome": "not_verified"},
     "expect": {"result": "NOT_VERIFIED", "sale_date": "NOT_VERIFIED"}},
    {"name": "auction_result_verified",
     "facts": {"ledger": "auction", "sale_date": true, "read_ever": true, "sale_outcome": "verified"},
     "expect": {"result": "VERIFIED"}},
    {"name": "certificate",
     "facts": {"ledger": "certificate", "parcel": true, "read_ever": true, "cert_number": true, "cert_face": true, "cert_interest": false, "cert_redemption": true},
     "expect": {"cert_number": "VERIFIED", "cert_face": "VERIFIED", "cert_interest": "NOT_PUBLISHED", "cert_redemption": "VERIFIED",
                "coords": "NOT_APPLICABLE", "acq_path": "NOT_APPLICABLE", "result": "NOT_APPLICABLE"}},
    {"name": "imagery_not_checked",
     "facts": {"ledger": "auction", "imagery": "not_checked"},
     "expect": {"imagery": "NOT_VERIFIED"}}
  ]
}
